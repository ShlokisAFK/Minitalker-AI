[Unit]
Description=Minitalker Local AI Server
After=network.target

[Service]
Type=simple
User=minitalker
WorkingDirectory=/home/minitalker/ai_project
ExecStart=/home/minitalker/ai_project/venv/bin/python model_server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
